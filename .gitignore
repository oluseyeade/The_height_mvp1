# ==============================================================================
# Git Ignore Specifications for The Height Application
# ==============================================================================

# Environment & Secret Files (CRITICAL)
.env
.env.*
!.env.example

# Byte-compiled / Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Databases & SQLite Files
*.db
*.sqlite
*.sqlite3
the_height_apartment.db
instance/

# Application Uploads, Receipts & Generated QR Codes
app/static/uploads/*
!app/static/uploads/.gitkeep
app/static/qrcodes/*
!app/static/qrcodes/.gitkeep

# System & Application Log Files
*.log
logs/

# Coverage & Test Output
.coverage
htmlcov/
.pytest_cache/
