# ==============================================================================
# The Height Apartment — Environment Configuration Template (.env.example)
# ==============================================================================

# Core Application Settings
FLASK_APP=starter.py
FLASK_ENV=development
SECRET_KEY=your-256-bit-secret-key-here
PORT=5050
HOST=127.0.0.1
USE_PROXY_FIX=False
PREFERRED_URL_SCHEME=http
SESSION_COOKIE_SECURE=False

# LOCAL DEVELOPMENT (MySQL)
DB_HOST=localhost
DB_PORT=<local-mysql-port>
DB_USER=<local-user>
DB_PASSWORD=<local-password>
DB_NAME=the_height
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=280

# RAILWAY PRODUCTION
# Set this in Railway Variables using a reference variable in Railway Dashboard.
# Do NOT put actual production credentials or passwords here.
# Recommended Railway Variable: MYSQL_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=
MYSQL_URL=

# Paystack Payment Integration Credentials (Development / Test Keys)
# NOTE: Maintain pk_test_ and sk_test_ keys during development stage
PAYSTACK_PUBLIC_KEY=your-paystack-public-test-key
PAYSTACK_SECRET_KEY=your-paystack-secret-test-key                                                           
PAYSTACK_CALLBACK_URL=http://127.0.0.1:5050/payments/paystack/callback
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
PAYSTACK_INITIALIZE_URL=https://api.paystack.co/transaction/initialize
PAYSTACK_VERIFY_URL=https://api.paystack.co/transaction/verify

# Persistent Volume Storage Backend Configuration (local volume)
STORAGE_BACKEND=local

# SMTP Mail Server Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=notifications@theheightapartment.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=notifications@theheightapartment.com

# WhatsApp API Configuration (Optional)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER=

# Analytics & Marketing Pixel Instrumentation
GA_MEASUREMENT_ID=
GOOGLE_ADS_CONVERSION_ID=
META_PIXEL_ID=
SITE_URL=http://127.0.0.1:5050

# Official Bank Details (Single Source of Truth)
BANK_NAME=Providus Bank
ACCOUNT_NUMBER=1309444506
ACCOUNT_NAME=The Height Premium Apartment
